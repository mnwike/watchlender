# Build-time settings. On GitHub these are repository Variables (Settings > Secrets and variables > Actions > Variables):
#   LEAD_ENDPOINT, LOANS_MODE, FCA_STATEMENT
NEXT_PUBLIC_SITE_URL=https://watchlender.co.uk
# URL that accepts the enquiry form as a JSON POST (a form service, or your own endpoint).
NEXT_PUBLIC_LEAD_ENDPOINT=
# "waitlist" (default) or "live". Go live only once the regulatory position is confirmed.
NEXT_PUBLIC_LOANS_MODE=waitlist
NEXT_PUBLIC_FCA_STATEMENT=
